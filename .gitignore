# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle root-project output (reports, kotlin caches)
/android/build/
/android/.kotlin/

# Release (scripts/deploy_stores.sh)
# Dart obfuscation symbols, one folder per release — kept outside build/ so
# `flutter clean` cannot delete them. Never commit, never delete.
/build_symbols/
# Crashlytics symbol-upload tool cache.
/.crashlytics/
# The Play service-account key lives beside the other Android signing secrets
# (android/key.properties, the keystore).
/android/play-service-account.json
/android/*service-account*.json
